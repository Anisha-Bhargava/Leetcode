RECURRSION

class Solution {
public:
    int f(int i,int j,string &s, string &rev){
        if(i<0 || j<0) return 0;
        if(s[i] == rev[j]) return 1 + f(i-1, j-1, s, rev);

        return max(f(i-1, j, s, rev), f(i, j-1, s, rev));
    }
    int minInsertions(string s) {
        string rev = s;
        reverse(rev.begin(), rev.end());
        int n = s.size();

        int lps = f(n-1, n-1,s,rev);

        return n-lps;
    }
};

MEMOIZATION

class Solution {
public:
    int f(int i,int j,string &s, string &rev,vector<vector<int>> &dp){
        if(i<0 || j<0) return 0;
        if(dp[i][j] != -1) return dp[i][j];
        if(s[i] == rev[j]) return 1 + f(i-1, j-1, s, rev,dp);

        return dp[i][j] = max(f(i-1, j, s, rev,dp), f(i, j-1, s, rev,dp));
    }
    int minInsertions(string s) {
        string rev = s;
        reverse(rev.begin(), rev.end());
        int n = s.size();

        vector<vector<int>> dp(n,vector<int>(n,-1));
        int lps = f(n-1, n-1,s,rev,dp);

        return n-lps;
    }
};

TABULATION

class Solution {
public:
    int minInsertions(string s) {
        string rev = s;
        reverse(rev.begin(), rev.end());

        int n = s.size();
        vector<vector<int>> dp(n+1, vector<int>(n+1, 0));

        for(int i = 1; i <= n; i++) {
            for(int j = 1; j <= n; j++) {
                if(s[i-1] == rev[j-1])
                    dp[i][j] = 1 + dp[i-1][j-1];
                else
                    dp[i][j] = max(dp[i-1][j], dp[i][j-1]);
            }
        }

        int lps = dp[n][n];
        return n - lps;
    }
};

SPACE OPTIMIZATION

class Solution {
public:
    int minInsertions(string s) {
        string rev = s;
        reverse(rev.begin(), rev.end());

        int n = s.size();
        vector<int> prev(n+1, 0);
        vector<int> curr(n+1, 0);

        for(int i = 1; i <= n; i++) {
            curr[0] = 0;
            for(int j = 1; j <= n; j++) {
                if(s[i-1] == rev[j-1])
                    curr[j] = 1 + prev[j-1];
                else
                    curr[j] = max(prev[j], curr[j-1]);
            }
            prev = curr;
        }

        int lps = prev[n];
        return n - lps;
    }
};
