### Partitions with Given Difference

A **modified version of Count Subsets with Sum K (Perfect Sum)**.

Let:
- `S1 + S2 = totalSum`
- `S1 - S2 = diff`

Therefore:

`S2 = (totalSum - diff) / 2`

So the problem reduces to **counting the number of subsets having sum `S2`**, using the same Perfect Sum DP (Recursion → Memoization → Tabulation).

Before DP:
- If `totalSum < diff` → `0`
- If `(totalSum - diff)` is odd → `0`

**Pattern:**  
`Partition with Given Difference → Derive Target → Count Subsets with Target Sum`

⚠️ Zero handling is important, same as Perfect Sum. If `arr[0] == 0` and `sum == 0`, return `2` because `0` can belong to either subset.



MEMOIZATION

class Solution {
  public:
  
    int f(int ind,int sum,vector<int>& arr, vector<vector<int>> &dp){
        if(ind == 0) {
            if(sum == 0 && arr[0] == 0) return 2;
            if(sum == 0 || arr[0] == sum) return 1;
            return 0;
        }
        if(dp[ind][sum] != -1) return dp[ind][sum];
        int notTake = f(ind-1,sum,arr,dp);
        int take=0;
        if(arr[ind]<=sum) take = f(ind-1,sum-arr[ind],arr,dp);
        return dp[ind][sum] = take + notTake;
    }
    int perfectSum(vector<int>& arr, int target) {
        int n=arr.size();
        vector<vector<int>> dp(n, vector(target+1,-1));
        return f(n-1,target,arr,dp);
    }
    int countPartitions(vector<int>& arr, int diff) {
        int totalsum = 0;
        for(int x : arr)
            totalsum += x;

        if(totalsum < diff) return 0;
        if((totalsum - diff) % 2 != 0) return 0;
        return perfectSum(arr,(totalsum - diff)/2);
        
    }
};

TABULATION

class Solution {
  public:
    int countPartitions(vector<int>& arr, int diff) {
        int n = arr.size();
        int totalsum = 0;
        for(int x : arr)
            totalsum += x;

        if(totalsum < diff) return 0;
        if((totalsum - diff) % 2 != 0) return 0;
        int target = (totalsum - diff)/2;
        vector<vector<int>> dp(n, vector(target+1,0));

        // Empty subset        
        dp[0][0] = 1;

        // Take arr[0]         
        if(arr[0] <= target) dp[0][arr[0]] += 1;

        for(int i=1;i<n;i++){
            for(int sum=0;sum<=target;sum++){
                int notTake = dp[i-1][sum];
                int take=0;
                if(arr[i]<=sum) take = dp[i-1][sum-arr[i]];
                dp[i][sum] = take + notTake;
            }
        }        
        return dp[n-1][target];
        
    }
};
