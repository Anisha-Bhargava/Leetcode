BRUTE FORCE (TLE OCCURS)

class Solution {
public:
    int subarraysWithKDistinct(vector<int>& nums, int k) {
        int n=nums.size();
        int cnt=0;
        for(int i=0;i<n;i++){
            map<int, int> mpp;
            for(int j=i;j<n;j++){
                mpp[nums[j]]++;
                if(mpp.size() == k) cnt++;
                else if(mpp.size() > k) break;
            }
        }
        return cnt;
    }
};


SLIDING WNIDOW (tc-O(nlogd) d=no. of dist int)

class Solution {
public:
    int atmost(vector<int>& nums, int k){
        int n=nums.size();
        int l=0,r=0,cnt=0;
        map<int, int> mpp;
        while(r<n){
            mpp[nums[r]]++;
            while(mpp.size() > k){
                mpp[nums[l]]--;
                if(mpp[nums[l]] == 0){
                    mpp.erase(nums[l]);
                }
                l++;        
            }
            cnt = cnt + (r-l+1);
            r++;
        }
        return cnt;
    }

    int subarraysWithKDistinct(vector<int>& nums, int k) {
        return atmost(nums,k) - atmost(nums, k-1);
    }
};


USING UNORDERED MAP - (Time: O(n) average ,Space: O(d))

class Solution {
public:
    int atmost(vector<int>& nums, int k){
        int n=nums.size();
        int l=0,r=0,cnt=0;
        unordered_map<int, int> mpp;
        if(k<0) return 0;
        while(r<n){
            mpp[nums[r]]++;
            while(mpp.size() > k){
                mpp[nums[l]]--;
                if(mpp[nums[l]] == 0){
                    mpp.erase(nums[l]);
                }
                l++;        
            }
            cnt = cnt + (r-l+1);
            r++;
        }
        return cnt;
    }

    int subarraysWithKDistinct(vector<int>& nums, int k) {
        return atmost(nums,k) - atmost(nums, k-1);
    }
};
