GREEDY APPROACH - (TC - O(N))

class Solution {
public:
    bool checkValidString(string s) {
        int n=s.size();
        int low=0;
        int high=0;

        for(int i=0;i<n;i++){
            if(s[i] == '('){
                low++;
                high++;
            }
            else if(s[i] == ')'){
                low--;
                high--;
            }
            else{
                low--;
                high++;
            }

            if(high<0) return false;

            low=max(0,low);
        }
        return low==0;
    }
};




USING 2 STACK - BRUTE FORCE - (TC - O(N) AND SC - O(N))

class Solution {
public:
    bool checkValidString(string s) {
        stack<int> open;
        stack<int> star;

        for(int i=0; i<s.size(); i++){
            if(s[i] == '('){
                open.push(i);
            }
            else if(s[i] == '*'){
                star.push(i);
            }
            else{
                if(!open.empty()){
                    open.pop();
                }
                else if(!star.empty()){
                    star.pop();
                }
                else{
                    return false;
                }
            }
        }

        while(!open.empty() && !star.empty()){
            if(open.top() < star.top()){
                open.pop();
                star.pop();
            }
            else{
                return false;
            }
        }

        return open.empty();
    }
};
