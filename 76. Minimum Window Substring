BRUTE FORCE 

class Solution {
public:
    string minWindow(string s, string t) {
        int n=s.size();
        int m=t.size();
        int minlen = INT_MAX, sIdx = -1;
        for(int i=0;i<n;i++){
            int hash[256] = {0};
            int cnt=0;
            for(int j=0;j<m;j++) hash[t[j]]++;
            for(int j=i;j<n;j++){
                if(hash[s[j]] > 0) cnt++;
                hash[s[j]]--;
                if(cnt==m){
                    if(j-i+1 < minlen){
                        minlen = j-i+1;
                        sIdx = i;
                    }
                    break;
                }
            }
        }
        if(sIdx == -1) return "";
        return s.substr(sIdx, minlen);
    }
};



OPTIMAL SOLUTION  - SLIDING WINDOW

class Solution {
public:
    string minWindow(string s, string t) {
        int n=s.size();
        int m=t.size();
        int minlen = INT_MAX, sIdx = -1, l=0, r=0, hash[256] = {0}, cnt=0;
        for(int i=0;i<m;i++) hash[t[i]]++;

        while(r<n){
            if(hash[s[r]] > 0) cnt++;
            hash[s[r]]--;

            while(cnt==m){
                if(r-l+1 < minlen){
                    minlen = r-l+1;
                    sIdx = l;
                }
                hash[s[l]]++;
                if(hash[s[l]] > 0) cnt--;
                l++;
            }
            r++;
        }
        if(sIdx == -1) return "";
        return s.substr(sIdx, minlen);
    }
};
