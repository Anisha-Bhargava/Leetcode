BRUTE FORCE - GENERATING ALL SUBARRAYS (TLE OCCURS)

class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        int n=fruits.size();
        int maxlen=0;
        for(int i=0;i<n;i++){
            set<int> st;
            for(int j=i;j<n;j++){
                st.insert(fruits[j]);
                if(st.size()<=2) maxlen = max(maxlen, j-i+1);
                else break;
            }
        }
        return maxlen; 
    }
};

OPTIMAL  - (TC - O(2N))

class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        int n=fruits.size();
        int maxlen=0,l=0;
        map<int, int> mpp;
        for(int r=0;r<n;r++){
            mpp[fruits[r]]++;
            while(mpp.size() > 2){
                mpp[fruits[l]]--;
                if(mpp[fruits[l]] == 0){
                    mpp.erase(fruits[l]);
                }
                l++;
            }
            maxlen = max(maxlen, r-l+1);
        }
        return maxlen; 
    }
};
