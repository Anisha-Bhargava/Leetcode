//same solution as house robber just the difference is that we can't take first and last together so we made two temp arrays 
//in that temp 1 will conation all elements excluding the first element and temp 2  will conation all elements excluding the last element
//so we will call the function twice 

Space optimization

class Solution {
public:
    int f(int ind, vector<int>& nums) {
        int prev = nums[0];
        int prev2 = 0;
        for(int i = 1; i <= ind; i++) {
            int take = nums[i];
            if(i > 1)
                take += prev2;
            int notTake = prev;
            int curri = max(take, notTake);

            prev2 = prev;
            prev = curri;
        }
        return prev;
    }

    int rob(vector<int>& nums) {
        vector<int> temp1, temp2;
        int n=nums.size();
        if(n==1) return nums[0];
        for(int i=0;i<n;i++){
            if(i != 0) temp1.push_back(nums[i]);
            if(i != n-1) temp2.push_back(nums[i]);
        }
        return max(f(temp1.size()-1,temp1), f(temp2.size()-1,temp2));
    }
};
