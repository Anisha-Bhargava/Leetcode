OPTIMAL SOLUTION

a)
class Solution {
public:
    int numberOfSubstrings(string s) {
        int n=s.size();
        int lastseen[3] = {-1, -1, -1};
        int cnt=0;
        for(int i=0;i<n;i++){
            lastseen[s[i] - 'a'] = i;
            if(lastseen[0] != -1 && lastseen[1] != -1 && lastseen[2] != -1){
                cnt = cnt + (1 + min({lastseen[0], lastseen[1], lastseen[2]}));
            }
        }
        return cnt;
    }
};


b) sliding window

class Solution {
public:
    int numberOfSubstrings(string s) {
        int n=s.size();
        int l=0, r=0, cnt=0;
        int freq[3] = {0};
        while(r<n){
            freq[s[r] - 'a']++;
            while(freq[0]>0 && freq[1]>0 && freq[2]>0){
                cnt = cnt + (n-r);
                freq[s[l] - 'a']--;
                l++;
            }
            r++;
        }
        return cnt;
    }
};

