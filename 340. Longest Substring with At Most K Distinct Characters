#include <map>
int kDistinctChars(int k, string &str)
{   
    int n=str.size();
    int l=0,r=0,cnt=0;
    map<char,int> mpp;
    while(r<n){
        mpp[str[r]]++;
        while(mpp.size() > k){
            mpp[str[l]]--;
            if(mpp[str[l]] == 0) mpp.erase(str[l]);
            l++;
        }
        cnt = max(cnt, r-l+1);
        r++;
    }
    return cnt;
}


