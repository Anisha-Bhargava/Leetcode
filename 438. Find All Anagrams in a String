class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        int n = s.size();
        int m = p.size();
        int l=0, r=0;
        vector<int> ans;

        if(m>n) return ans;
        int freqP[256] = {0};
        int freqS[256] = {0};

        for(int i=0;i<m;i++) freqP[p[i] - 'a']++;

        while(r<n){
            freqS[s[r] - 'a']++;

            if(r-l+1 > m){
                freqS[s[l] - 'a']--;
                l++;
            }

            if(r-l+1 == m){
                bool same = true;
                for(int i=0;i<26;i++){
                    if(freqS[i] != freqP[i]){
                        same = false;
                        break;
                    }
                }
                if(same) ans.push_back(l);
            }
            r++;
        }
        return ans;
    }
};
