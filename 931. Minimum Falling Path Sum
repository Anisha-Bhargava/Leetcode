RECURRSION (TLE)

class Solution {
public:
    int f(int i, int j, vector<vector<int>>& matrix){
        if(j<0 || j>=matrix.size()) return INT_MAX;
        if(i==0) return matrix[0][j];
        
        int up = f(i-1,j,matrix);
        int left = f(i-1,j-1,matrix);
        int right = f(i-1,j+1,matrix);

        return matrix[i][j] + min({up,left,right});
    }
    int minFallingPathSum(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int ans = INT_MAX;
        for(int j = 0; j < n; j++) {
            ans = min(ans, f(n-1, j, matrix));
        }
        return ans;
    }
};

MEMOIZATION (TLE)

class Solution {
public:
    int f(int i, int j, vector<vector<int>>& matrix, vector<vector<int>>& dp){
        if(j<0 || j>=matrix.size()) return INT_MAX;
        if(i==0) return matrix[0][j];
        
        if(dp[i][j] != -1) return dp[i][j];

        int up = f(i-1,j,matrix,dp);
        int left = f(i-1,j-1,matrix,dp);
        int right = f(i-1,j+1,matrix,dp);

        return dp[i][j] = matrix[i][j] + min({up,left,right});
    }
    int minFallingPathSum(vector<vector<int>>& matrix) {
        int n = matrix.size();
        int ans = INT_MAX;

        vector<vector<int>> dp(n, vector<int>(n, -1));

        for(int j = 0; j < n; j++) {
            ans = min(ans, f(n-1, j, matrix,dp));
        }
        return ans;
    }
};

TABULATION

class Solution {
public:
    int minFallingPathSum(vector<vector<int>>& matrix) {
        int n = matrix.size();
        vector<vector<int>> dp(n, vector<int>(n,0));

        for(int j = 0; j < n; j++) {
            dp[0][j] = matrix[0][j];
        }

        for(int i=1;i<n;i++){
            for(int j=0;j<n;j++){
                int up = dp[i-1][j];

                int left = INT_MAX;
                if(j>0) left = dp[i-1][j-1];

                int right = INT_MAX;
                if(j<n-1) right = dp[i-1][j+1];

                dp[i][j] = matrix[i][j] + min({up,left,right});

            }
        }
        int ans = INT_MAX;
        for(int j=0;j<n;j++){
            ans = min(ans, dp[n-1][j]);
        }
        return ans;
    }
};
