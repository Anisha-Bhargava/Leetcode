BRUTE FORCE

class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int n = s.length();
        int maxlen=0;
        for(int i=0;i<n;i++){
            int hash[256] = {0};
            for(int j=i;j<n;j++){
                if(hash[s[j]]==1) break;
                int len = j-i+1;
                maxlen = max(maxlen,len);
                hash[s[j]]=1;
            }
        }
        return maxlen;
    }
};

OPTIMAL APPROACH

class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int n = s.length();
        int maxlen=0;
        int l=0, r=0;
        int hash[256];
        for(int i=0;i<256;i++){
            hash[i] = -1;
        }

        while(r<n){
            if(hash[s[r]] != -1){
                if(hash[s[r]] >= l){
                    l = hash[s[r]] +1;
                }
            }
            int len = r-l+1;
            maxlen = max(maxlen, len);
            hash[s[r]] = r;
            r++;
        }
        return maxlen;
    }
};
