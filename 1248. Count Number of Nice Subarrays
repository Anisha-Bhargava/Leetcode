class Solution {
public:
    int atmost(vector<int>& nums, int k){
        int n=nums.size();
        int l=0, r=0, ans=0;
        while(r<n){
            if(nums[r]%2==1) k--;
            while(k<0){
                if(nums[l]%2==1) k++;
                l++;
            }
            ans = ans + (r-l+1);
            r++;
        }
        return ans;
    }
    int numberOfSubarrays(vector<int>& nums, int k) {
        return atmost(nums,k) - atmost(nums,k-1);
    }
};
