FOR BRUTE FORCE AND BETTER SOLUTION CAN VISIT COUNT SUBARRAYS SUM EQUAL K...ITS THERE WITH JUST MINOR DIFF

OPTIMAL APPROACH (TC - O(2*2N), SC - O(1))
class Solution {
public:
    int atmost(vector<int>& nums, int goal){
        int n = nums.size();
        int l=0,r=0,sum=0,cnt=0;
        if(goal<0) return 0;
        while(r<n){
            sum += nums[r];
            while(sum>goal){
                sum -= nums[l];
                l++;
            }
            cnt = cnt + (r-l+1);
            r++;
        }
        return cnt;
    }
    int numSubarraysWithSum(vector<int>& nums, int goal) {
        return atmost(nums,goal) - atmost(nums,goal-1);
    }

};
