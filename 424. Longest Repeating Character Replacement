OPTIMAL APPROACH

class Solution {
public:
    int characterReplacement(string s, int k) {
        int n = s.size();
        int maxlen=0, l=0, r=0;
        int ans=0;
        int maxfreq=0;
        map<char,int> mpp;
        while(r<n){
            mpp[s[r]]++;
            maxfreq = max(maxfreq, mpp[s[r]]);

            while((r-l+1) - maxfreq > k){
                mpp[s[l]]--;
                l++;
            }
            ans= max(ans,r-l+1);
            r++;
        }
        return ans;
    }
};
