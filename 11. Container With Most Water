BRUTE FORCE - TLE OCCURS (TC - O(N^2))

class Solution {
public:
    int maxArea(vector<int>& height) {
        int n=height.size();
        int maxwater=0;
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                int width = j-i;
                int h = min(height[i], height[j]);
                int area = h*width;
                maxwater = max(maxwater, area);
            }
        }
        return maxwater;
    }
};

OPTIMAL SOLUTION - TWO POINTERS (TC - O(N))

class Solution {
public:
    int maxArea(vector<int>& height) {
        int n=height.size();
        int maxwater=0, l=0, r=n-1;
        while(l<r){
            int width = r-l;
            int h = min(height[l], height[r]);
            int area = h*width;
            maxwater = max(maxwater, area);
            if(height[l] < height[r]) l++;
            else r--;            
        }
        return maxwater;
    }
};
